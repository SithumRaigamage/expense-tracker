# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env

# REQUIRED. Signs session tokens. Generate a fresh one — never ship the default
# from expensive-tracker-backend/.env:
#   openssl rand -base64 48
JWT_SECRET=

# How long a session lasts. The auth cookie expires alongside the token.
JWT_EXPIRE=30d

# Host port the app is published on.
FRONTEND_PORT=8080

# The address users actually reach, including scheme. Used for CORS.
# In production this must be the https:// address of your TLS terminator.
PUBLIC_URL=http://localhost:8080
