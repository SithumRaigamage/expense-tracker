{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_|^next$" }],
    "no-console": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-return-await": "warn"
  },
  "overrides": [
    {
      "files": ["scripts/**", "dummy-data/**", "tests/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
