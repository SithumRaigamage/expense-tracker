# Environment Configuration
NODE_ENV=development
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/expense-tracker
# Tests never run against the database above: they derive a "-test" sibling
# (per jest worker). Override here only if tests need a different server.
# MONGODB_URI_TEST=mongodb://localhost:27017/expense-tracker-test

# JWT Configuration
# REQUIRED. The server refuses to start if this is missing or left as the
# placeholder below. Generate one with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=30d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (for future features)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# File Upload Configuration
MAX_FILE_SIZE=5242880
FILE_UPLOAD_PATH=./public/uploads

# Rate Limiting (general API budget; auth endpoints are capped separately at
# 10 failed attempts per 15 minutes)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15
