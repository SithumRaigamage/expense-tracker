# Environment Configuration
NODE_ENV=development
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/expense-tracker
# Tests never run against the database above: they derive a "-test" sibling
# (per jest worker). Override here only if tests need a different server.
# MONGODB_URI_TEST=mongodb://localhost:27017/expense-tracker-test

# JWT Configuration
# REQUIRED. The server refuses to start if this is missing or left as the
# placeholder below. Generate one with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=30d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (for future features)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# File Upload Configuration
MAX_FILE_SIZE=5242880
FILE_UPLOAD_PATH=./public/uploads

# Rate Limiting. General per-IP API budget per window; one dashboard load costs
# roughly ten requests, so keep this generous. Auth endpoints are capped
# separately and far more tightly (10 failed attempts per 15 minutes).
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=15

# Recurring Expense Engine
# Set to 'true' to auto-generate recurring expenses in-process (daily) while the
# server runs. Leave unset and use `npm run recurring:run` via cron otherwise.
ENABLE_RECURRING_SCHEDULER=false

# Receipt OCR (POST /api/v1/expenses/receipt/scan)
# Get a free key at https://ocr.space/ocrapi. Without a key, receipts are stored
# but fields are not auto-extracted.
OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=
OCR_LANGUAGE=eng
